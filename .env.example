# Copy to .env and fill in. Every variable the app or the compose stack reads
# must be documented here.
#
# Hostnames: the URLs below are host-facing (localhost + the dev-only port
# mappings in docker-compose.dev.yml), because `next dev` runs outside Docker.
# Once web/worker are containerised they use the service names on the
# cartwright network instead: postgres:5432, redis:6379, redis-queue:6379,
# meilisearch:7700, minio:9000, mailpit:1025.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=cartwright
POSTGRES_PASSWORD=cartwright_dev
POSTGRES_DB=cartwright
DATABASE_URL=postgresql://cartwright:cartwright_dev@localhost:5432/cartwright

# --- Redis --------------------------------------------------------------
# Cache, sessions, rate limits, reservations. Evicts under memory pressure.
REDIS_URL=redis://localhost:6379
# BullMQ. Separate instance, no eviction — jobs are not rebuildable.
QUEUE_REDIS_URL=redis://localhost:6380

# --- Better Auth --------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Meilisearch --------------------------------------------------------
MEILI_MASTER_KEY=cartwright_dev_master_key
MEILI_HOST=http://localhost:7700

# --- Object storage (MinIO in dev, any S3 in prod) ----------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cartwright-media
S3_ACCESS_KEY_ID=cartwright
S3_SECRET_ACCESS_KEY=cartwright_dev_secret
# MinIO requires path-style addressing; real S3 does not.
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit in dev) ---------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Northgate Supply <no-reply@northgatesupply.test>
